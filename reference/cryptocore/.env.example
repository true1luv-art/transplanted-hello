# ============================================================
# CryptoCore — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================


# ------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------

# MongoDB connection string.
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/cryptocore?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/cryptocore
MONGODB_URI=

# MongoDB database name (default: cryptocore).
MONGODB_DB=cryptocore


# ------------------------------------------------------------
# AUTH (required in production)
# ------------------------------------------------------------

# Secret used to sign and verify JWT session tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=


# ------------------------------------------------------------
# BLOCKCHAIN — Solana (required for deposits / withdrawals)
# ------------------------------------------------------------

# SPL token mint address for the HASH game token.
CONTRACT_ADDRESS=

# Treasury wallet public key that receives deposits and pays withdrawals.
TREASURY_ADDRESS=

# Treasury wallet private key (base58, server-only — never expose to the client).
TREASURY_KEY=

# Solana JSON-RPC endpoint.
# Devnet:   https://api.devnet.solana.com
# Mainnet:  https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Helius API key for reliable RPC and on-chain verification. Optional but recommended.
# Get one at https://helius.dev
HELIUS_API_KEY=


# ------------------------------------------------------------
# BLOCKCHAIN — client-side (required for deposits / marketplace purchases)
# ------------------------------------------------------------
# The browser signs and sends real SPL token transfers with Phantom, so it
# needs to know the mint and treasury address too. These MUST match
# CONTRACT_ADDRESS / TREASURY_ADDRESS above — never put TREASURY_KEY here.

# Same value as CONTRACT_ADDRESS, exposed to the browser.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Same value as TREASURY_ADDRESS, exposed to the browser.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Solana RPC endpoint used by the browser wallet. Defaults to devnet if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
