# ─────────────────────────────────────────────────────────────────────────────
# HiveX NFTs — environment variables
# Copy to `.env` and fill in real values. Only the backend API service
# (server:api / server:smart-contract) reads these; the frontend is static.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # debug | info | warn | error | silent

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local Mongo on 127.0.0.1:27017 by default. For a remote instance, use the
# full SRV/standard URI, e.g. mongodb+srv://user:pass@cluster.example.net
DATABASE_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=hivex-nfts

# ── API server ────────────────────────────────────────────────────────────────
API_PORT=4000

# ── Smart-contract worker ─────────────────────────────────────────────────────
SMART_CONTRACT_POLL_INTERVAL_MS=1500  # poll cadence for pending transactions
SMART_CONTRACT_MAX_ATTEMPTS=3         # attempts before a tx is failed permanently
BLOCKCHAIN_LATENCY=400                 # simulated blockchain latency, ms

# ── Blockchain driver ────────────────────────────────────────────────────────
# mock  = no network, no keys (default for local dev)
# hive  = real Hive reads (and writes when broadcasting is enabled)
BLOCKCHAIN_DRIVER=mock

# Auto-seed the database when empty. Disable in production.
AUTO_SEED=true

# Development username used until Hive Keychain auth is wired in.
DEV_USER=rhiaji

# ── Hive blockchain (only relevant when BLOCKCHAIN_DRIVER=hive) ───────────────
# Comma-separated RPC nodes, tried in order on failover.
HIVE_RPC_NODES=https://api.hive.blog
# HIVE_RPC_URL=                        # legacy alias; HIVE_RPC_NODES wins
HIVE_NETWORK=mainnet                  # mainnet | testnet
# HIVE_CHAIN_ID=                       # override; empty = dHive default
# HIVE_ADDRESS_PREFIX=                 # override; empty = dHive default
HIVE_ACCOUNT=                         # Hive account the backend broadcasts from
PLATFORM_ACCOUNT=hivex-nfts           # public platform account receiving fees
MARKET_ACCOUNT=hivex-nfts-market      # platform wallet / market account
# HIVE_ACTIVE_KEY=                     # SERVER-ONLY. Never expose to the browser.
HIVE_RPC_TIMEOUT=5000
HIVE_FAILOVER_THRESHOLD=3
HIVE_BROADCAST_ENABLED=false          # set true to broadcast real transactions
HIVE_ENGINE_API=https://api.hive-engine.com/rpc

# ── Mock Keychain ─────────────────────────────────────────────────────────────
KEYCHAIN_DEFAULT_OUTCOME=approve      # approve | reject (simulate user decline)
KEYCHAIN_LATENCY=120                  # simulated signing latency, ms

# ── Asset storage (Mock IPFS) ─────────────────────────────────────────────────
STORAGE_UPLOAD_LATENCY=25             # simulated per-upload latency, ms
STORAGE_FAILURE_RATE=0                # 0..1 — simulated per-upload failure rate
MAX_ASSET_FILE_SIZE=10485760         # max single NFT asset file, bytes (10 MiB)
MAX_COLLECTION_ASSET_SIZE=15728640   # max collection artwork, bytes (15 MiB)
MAX_NFT_ASSETS=10000                 # max NFT asset files per collection

# ── Fees (HIVE) ───────────────────────────────────────────────────────────────
NFT_CREATION_COST_PER_MINT=0.1        # HIVE charged per mintable slot on deploy
PLATFORM_MINT_FEE_PERCENT=5           # platform cut of every mint, %
MARKETPLACE_FEE_PERCENT=2.5           # platform cut of every sale, %

# ── Frontend (optional) ──────────────────────────────────────────────────────
# Override the API base the browser talks to. Defaults to "/api" (same-origin).
# Set this only when the API service runs on a different origin.
# VITE_API_BASE_URL=http://localhost:4000/api
